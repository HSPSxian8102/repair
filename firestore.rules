rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }
    function isSchoolAccount() {
      return isAuthed() && request.auth.token.email.matches('.*@gm\\.tntcsh\\.tn\\.edu\\.tw$');
    }
    function isAdmin() {
      return isSchoolAccount() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // ── repairs ──
    match /repairs/{id} {
      allow read: if isSchoolAccount();
      allow create: if isSchoolAccount();
      allow update: if isSchoolAccount() && (
        isAdmin() ||
        // 提交者只能將「待處理」單取消，且只允許修改 status 與 cancelledAt 欄位
        (request.auth.uid == resource.data.submittedBy &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
      );
      allow delete: if isAdmin();
    }

    // ── admins ──
    match /admins/{uid} {
      allow read:  if isSchoolAccount();
      allow write: if isSuperAdmin();
    }

    // ── locations ──
    match /locations/{id} {
      allow read:  if isSchoolAccount();
      allow write: if isSuperAdmin();
    }
  }
}
